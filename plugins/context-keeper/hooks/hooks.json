{
  "description": "写入长注释块时提醒注释只留一条结论和最多一句理由，经过、状态、数字表留给 commit 和 PR（CONTEXT_KEEPER_COMMENT_HOOK=0 关闭）",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/scripts/comment-hook.mjs\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
